#!/usr/bin/env bash
# generate-redirects — thin launcher for the Python gate.
#
# The native-Faber conversion (NSM-F1) retired with radix core-norma N2: the
# I/O kernel modules (`faber:solum`, `faber:processus`, `faber:consolum`) are
# no longer importable in script mode, so the staged .fab gate cannot run on
# current radix. The gate body lives in generate-redirects.py, byte-stable
# with the .fab output it replaces.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec python3 "${SCRIPT_DIR}/generate-redirects.py" "$@"
