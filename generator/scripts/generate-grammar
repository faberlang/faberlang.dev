#!/usr/bin/env bash
set -euo pipefail
# NSM-F1: native-Faber gate launcher. The gate logic lives entirely in
# generate-grammar.fab; this entrypoint only runs it on the released faber
# binary (faber/target/debug/faber, 1.6.0-rc.1). The PATH `faber` (1.3.0) is
# never a valid execution surface. FABER_BIN overrides the binary.
#
# `faber script` interprets a single source only when the path is not covered
# by a faber.toml (package routing rejects kernel imports with PKG001), so the
# gate source is staged outside the faberlang.dev package before
# interpretation. Staging happens in a per-run mktemp dir under
# ${TMPDIR:-/tmp} — the ephemeral equivalent of the canonical workspace-level
# home <workspace>/scripta/.fab-gates/ (delivery.md §4.9); .fab content is
# location-independent, so staging changes nothing but the package routing.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"
FABER_BIN="${FABER_BIN:-$(cd "$ROOT/.." && pwd)/faber/target/debug/faber}"
export FABER_BIN
if [[ ! -x "$FABER_BIN" ]]; then
    echo "generate-grammar: released faber binary not found: $FABER_BIN (set FABER_BIN)" >&2
    exit 1
fi
TMP="$(mktemp -d "${TMPDIR:-/tmp}/generate-grammar.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
cp "$ROOT/generator/scripts/generate-grammar.fab" "$TMP/generate-grammar.fab"
if "$FABER_BIN" script "$TMP/generate-grammar.fab" -- "$@"; then
    exit 0
else
    exit $?
fi
