+++
locale = "en"
+++

# faberlang.dev/generator/scripts/generate-redirects.fab — native-Faber gate
# (NSM Wave-2 F1, conversion of the retired generate-redirects.py).
#
# Walks dist/<source_site_locale>/**/*.html and writes a minimal HTML
# meta-refresh stub at dist/<rel> for every rendered page, byte-stable vs the
# Python original. Uses directory URL style (/en-US/, not /en-US/index.html).
# dist/index.html is owned by the portal and is never overwritten (skipped).
# Stubs carry noindex so they do not compete with the real locale pages.
#
# Usage: generate-redirects <dist_dir> <source_site_locale>
# Exit contract (same as argparse in the original): 0 on success — also when
# the source locale directory is missing (a warning, not a failure) — and 2
# on usage errors.
#
# Execution surface (pinned): the released faber binary via `faber script`,
# staged outside every faber.toml tree by the launcher (generator/scripts/
# generate-redirects). The recursive .html walk shells out to `find`.

import from "faber:solum" private fileio
import from "faber:processus" private processus
import from "faber:consolum" private consolum

const string base_url ← "https://faberlang.dev"

# html.escape(target, quote=True) entity table: & < > " ' (the single quote
# is the hex entity &#x27;, matching the Python original exactly).
fn html_escape(string s) → string {
    return s.muta("&", "&amp;").muta("<", "&lt;").muta(">", "&gt;").muta("\"", "&quot;").muta("'", "&#x27;")
}

# The redirect stub template (the Python STUB.format, with both values
# already escaped by the caller).
fn stub(string target_url, string canonical_url) → string {
    return "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"robots\" content=\"noindex\">\n<meta http-equiv=\"refresh\" content=\"0; url=" + target_url + "\">\n<link rel=\"canonical\" href=\"" + canonical_url + "\">\n<title>Redirect</title>\n</head>\n<body><p>Moved to <a href=\"" + target_url + "\">" + target_url + "</a>.</p></body>\n</html>\n"
}

main {
    const list<string> argv ← processus.argumenta() ↦ list<string>
    if argv.longitudo() ≠ 2 {
        consolum.mone("usage: generate-redirects <dist_dir> <source_site_locale>")
        processus.exi(2)
    }
    var string dist_dir ← ""
    var string site_locale ← ""
    var int idx ← 0
    for from argv const a {
        if idx ≡ 0 {
            dist_dir ← a
        }
        if idx ≡ 1 {
            site_locale ← a
        }
        idx ← idx + 1
    }
    const string source_dir ← dist_dir + "/" + site_locale
    if fileio.directoriumne(source_dir) ↦ bivalens ≡ falsum {
        print "WARNING: source locale directory not found: " + source_dir
        processus.exi(0)
    }
    const string found ← processus.exsequi("find '" + source_dir + "' -type f -name '*.html'") ↦ string
    const list<string> lines ← found.divide("\n") ↦ list<string>
    var list<string> paths ← []
    for from lines const p {
        if p.longitudo() > 0 {
            paths.appende(p)
        }
    }
    const list<string> sorted ← paths.ordinata() ↦ list<string>
    var int written ← 0
    var int skipped ← 0
    for from sorted const html_path {
        const int prefix_len ← source_dir.longitudo() + 1
        const string rel ← html_path.sectio(prefix_len, html_path.longitudo())
        if rel ≡ "index.html" {
            skipped ← skipped + 1
        } else {
            const string target ← "/" + site_locale + "/" + rel
            const string enc_target ← html_escape(target)
            const string canon ← base_url + target
            const string enc_canonical ← html_escape(canon)
            const string stub_path ← dist_dir + "/" + rel
            const string parent ← fileio.parens(stub_path) ↦ string
            if fileio.directoriumne(parent) ↦ bivalens ≡ falsum {
                fileio.crea(parent)
            }
            fileio.scribe(stub_path, stub(enc_target, enc_canonical))
            written ← written + 1
        }
    }
    print "Generated " + "§"(written) + " redirect stubs for " + site_locale + " → bare paths"
}
