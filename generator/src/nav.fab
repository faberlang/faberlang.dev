# Hierarchical site navigation.
#
# Owns the sidebar tree: five reader-task groups (Start, The Language,
# Targets, Reader locales, Libraries). Labels here are English; per-locale
# spellings come from generator/locales/<locale>/chrome.toml through
# inject-chrome.py, which replaces these exact strings inside <aside> after
# render. chrome.toml mirrors the same tree under [[nav.group]] as the
# registry seats edit; this file is what actually renders, so a structural
# change lands in both.
#
# Items with children render as <details class="nav-branch"> with a
# <summary>; the branch is open when its subtree covers the page's section
# or the exact page. An item is active on exact URL match, or, when the page
# has no nav item of its own, when it is the only item carrying its section.

importa ex "./document_ir" * ut doc_mod
importa ex "./link_prefix" * ut lp

genus NavItem {
    varia textus label
    varia textus href
    varia textus section
    varia lista<NavItem> children
}

genus NavGroup {
    varia textus id
    varia textus label
    varia lista<NavItem> items
}

functio finge_item(textus label, textus href, textus section) → NavItem {
    redde NavItem { label = label, href = href, section = section, children = vacua }
}

# Families that ship en-US only. The absolute href survives content_href on
# every locale, so partial trees link the canonical English page instead of
# a locale path that does not exist.
functio finge_en_item(textus label, textus href, textus section) → NavItem {
    redde finge_item(label, "/en-US" + href, section)
}

functio finge_branch(textus label, textus href, textus section, lista<NavItem> children) → NavItem {
    redde NavItem { label = label, href = href, section = section, children = children }
}

functio finge_group(textus id, textus label, lista<NavItem> items) → NavGroup {
    redde NavGroup { id = id, label = label, items = items }
}

# The sidebar tree. Hrefs are locale-relative content paths; sections are
# the frontmatter `section` of the target pages.
functio nav_tree() → lista<NavGroup> {
    varia lista<NavItem> behavior_children ← vacua
    behavior_children.appende(finge_en_item("Types before names", "/language/behavior/type-first.html", "behavior-type-first"))
    behavior_children.appende(finge_en_item("The glyph law", "/language/behavior/glyph-law.html", "behavior-glyph-law"))
    behavior_children.appende(finge_en_item("Math in the ether", "/language/behavior/numeric-widths.html", "behavior-numeric-widths"))
    behavior_children.appende(finge_en_item("Sealed reader locales", "/language/behavior/sealed-locales.html", "behavior-sealed-locales"))
    behavior_children.appende(finge_en_item("A program is a package", "/language/behavior/packages.html", "behavior-packages"))
    behavior_children.appende(finge_en_item("Errors as values, tests as declarations", "/language/behavior/errors-and-tests.html", "behavior-errors-and-tests"))

    varia lista<NavItem> grammar_children ← vacua
    grammar_children.appende(finge_item("Grammar overview", "/reference/grammar.html", "grammar"))
    grammar_children.appende(finge_en_item("Programs, regions & imports", "/reference/grammar/program.html", "grammar-program"))
    grammar_children.appende(finge_en_item("Declarations & bindings", "/reference/grammar/declarations.html", "grammar-declarations"))
    grammar_children.appende(finge_en_item("Annotations & directives", "/reference/grammar/annotations.html", "grammar-annotations"))
    grammar_children.appende(finge_en_item("Types & contracts", "/reference/grammar/types.html", "grammar-types"))
    grammar_children.appende(finge_en_item("Statements & control flow", "/reference/grammar/statements.html", "grammar-statements"))
    grammar_children.appende(finge_en_item("Expressions & operators", "/reference/grammar/expressions.html", "grammar-expressions"))
    grammar_children.appende(finge_en_item("Patterns & destructuring", "/reference/grammar/patterns.html", "grammar-patterns"))
    grammar_children.appende(finge_en_item("Error channel", "/reference/grammar/errors.html", "grammar-errors"))
    grammar_children.appende(finge_en_item("Lexical structure & glyphs", "/reference/grammar/lexical.html", "grammar-lexical"))

    varia lista<NavItem> start_items ← vacua
    start_items.appende(finge_item("Start here", "/start/", "start"))

    varia lista<NavItem> language_items ← vacua
    language_items.appende(finge_en_item("Overview", "/language/overview.html", "overview"))
    language_items.appende(finge_branch("Behavior", "", "", behavior_children))
    language_items.appende(finge_branch("Grammar", "", "", grammar_children))
    language_items.appende(finge_item("Terms A–Z", "/corpus/az.html", "corpus"))
    language_items.appende(finge_item("Cheat sheet", "/cheatsheet/", "cheatsheet"))

    varia lista<NavItem> hir_children ← vacua
    hir_children.appende(finge_en_item("Rust", "/targets/rust.html", "rust"))
    hir_children.appende(finge_en_item("TypeScript", "/targets/ts.html", "ts"))
    hir_children.appende(finge_en_item("Go", "/targets/go.html", "go"))
    hir_children.appende(finge_en_item("Faber", "/targets/faber.html", "faber"))

    varia lista<NavItem> mir_children ← vacua
    mir_children.appende(finge_en_item("LLVM IR", "/targets/llvm-text.html", "llvm-text"))
    mir_children.appende(finge_en_item("WebAssembly text", "/targets/wasm-text.html", "wasm-text"))

    varia lista<NavItem> gpu_children ← vacua
    gpu_children.appende(finge_en_item("Metal", "/targets/metal-text.html", "metal-text"))
    gpu_children.appende(finge_en_item("WGSL", "/targets/wgsl-text.html", "wgsl-text"))

    varia lista<NavItem> targets_items ← vacua
    targets_items.appende(finge_en_item("All targets", "/targets/", "targets"))
    targets_items.appende(finge_branch("Application · HIR", "", "", hir_children))
    targets_items.appende(finge_branch("Systems · MIR", "", "", mir_children))
    targets_items.appende(finge_branch("Device · GPU", "", "", gpu_children))
    targets_items.appende(finge_item("Target matrix", "/toolchain/target-matrix.html", "target-matrix"))

    varia lista<NavItem> locales_items ← vacua
    locales_items.appende(finge_item("Reader locales", "/language/reader-locales.html", "locales"))
    locales_items.appende(finge_en_item("Keyword reference", "/language/locales/keywords.html", "locales"))
    locales_items.appende(finge_en_item("Locale examples", "/language/locales/examples.html", "locales"))
    locales_items.appende(finge_en_item("Diagnostics by locale", "/language/locales/diagnostics.html", "locales"))

    varia lista<NavItem> libraries_items ← vacua
    libraries_items.appende(finge_item("Norma — stdlib", "/libraries/norma.html", "libraries"))
    libraries_items.appende(finge_item("Triga — graphics", "/libraries/triga.html", "libraries"))
    libraries_items.appende(finge_item("Gradus — autograd", "/libraries/gradus.html", "libraries"))
    libraries_items.appende(finge_item("Tela — views", "/libraries/tela.html", "libraries"))
    libraries_items.appende(finge_item("Inferentia — inference", "/libraries/inferentia.html", "libraries"))
    libraries_items.appende(finge_item("The corpus", "/libraries/corpus.html", "libraries"))

    varia lista<NavGroup> groups ← vacua
    groups.appende(finge_group("start", "Start", start_items))
    groups.appende(finge_group("language", "The Language", language_items))
    groups.appende(finge_group("targets", "Targets", targets_items))
    groups.appende(finge_group("locales", "Reader locales", locales_items))
    groups.appende(finge_group("libraries", "Libraries", libraries_items))
    redde groups
}

# True when the item or any descendant names the page's section.
functio subtree_habet_sectionem(NavItem it, textus active_section) → bivalens {
    si it.section ≡ active_section et active_section.longitudo() > 0 ergo redde verum
    varia bivalens found ← falsum
    itera ex it.children fixum child {
        si subtree_habet_sectionem(child, active_section) {
            found ← verum
        }
    }
    redde found
}

# Count nav items across the whole tree carrying one section.
functio numerus_sectionis(lista<NavGroup> groups, textus section) → numerus {
    varia numerus n ← 0
    itera ex groups fixum g {
        itera ex g.items fixum it {
            si it.section ≡ section {
                n ← n + 1
            }
            itera ex it.children fixum child {
                si child.section ≡ section {
                    n ← n + 1
                }
            }
        }
    }
    redde n
}

# Exact page match: the item's rendered href equals the page's own URL.
functio est_pagina(NavItem it, textus pagina_href, textus site_locale) → bivalens {
    redde lp.content_href(it.href, site_locale) ≡ pagina_href
}

# True when some nav item (top level or child) is exactly this page.
functio pagina_in_arbore(lista<NavGroup> groups, textus pagina_href, textus site_locale) → bivalens {
    varia bivalens found ← falsum
    itera ex groups fixum g {
        itera ex g.items fixum it {
            si est_pagina(it, pagina_href, site_locale) {
                found ← verum
            }
            itera ex it.children fixum child {
                si est_pagina(child, pagina_href, site_locale) {
                    found ← verum
                }
            }
        }
    }
    redde found
}

# Active on exact match, else when uniquely carrying the page's section.
functio est_activa(NavItem it, textus active_section, textus pagina_href, textus site_locale, numerus section_n) → bivalens {
    si est_pagina(it, pagina_href, site_locale) ergo redde verum
    si section_n ≡ 1 et it.section ≡ active_section ergo redde verum
    redde falsum
}

# A branch stays open when its subtree covers the active section or page.
functio patet_brachium(NavItem it, textus active_section, textus pagina_href, textus site_locale) → bivalens {
    si subtree_habet_sectionem(it, active_section) ergo redde verum
    varia bivalens found ← falsum
    itera ex it.children fixum child {
        si est_pagina(child, pagina_href, site_locale) {
            found ← verum
        }
    }
    redde found
}

functio nav_link_node(NavItem it, textus active_section, textus pagina_href, textus site_locale, numerus section_n) → doc_mod.Node {
    fixum textus href ← lp.content_href(it.href, site_locale)
    si est_activa(it, active_section, pagina_href, site_locale, section_n) {
        redde doc_mod.leaf("a", [doc_mod.attr("href", href), doc_mod.attr("class", "active")], it.label)
    }
    redde doc_mod.leaf("a", [doc_mod.attr("href", href)], it.label)
}

functio nav_branch_node(NavItem it, textus active_section, textus pagina_href, textus site_locale, numerus section_n) → doc_mod.Node {
    varia lista<doc_mod.Attr> attrs ← vacua
    attrs.appende(doc_mod.attr("class", "nav-branch"))
    si patet_brachium(it, active_section, pagina_href, site_locale) {
        attrs.appende(doc_mod.attr("open", ""))
    }

    varia lista<doc_mod.Node> child_items ← vacua
    itera ex it.children fixum child {
        child_items.appende(doc_mod.element("li", vacua, [nav_link_node(child, active_section, pagina_href, site_locale, section_n)]))
    }

    fixum doc_mod.Node summary ← doc_mod.leaf("summary", vacua, it.label)
    fixum doc_mod.Node list ← doc_mod.element("ul", vacua, child_items)
    redde doc_mod.element("details", attrs, [summary, list])
}

functio nav_item_node(NavItem it, textus active_section, textus pagina_href, textus site_locale, numerus section_n) → doc_mod.Node {
    si it.children.longitudo() > 0 {
        redde doc_mod.element("li", vacua, [nav_branch_node(it, active_section, pagina_href, site_locale, section_n)])
    }
    redde doc_mod.element("li", vacua, [nav_link_node(it, active_section, pagina_href, site_locale, section_n)])
}

functio nav_group_node(NavGroup g, textus active_section, textus pagina_href, textus site_locale, numerus section_n) → doc_mod.Node {
    varia lista<doc_mod.Node> items ← vacua
    itera ex g.items fixum it {
        items.appende(nav_item_node(it, active_section, pagina_href, site_locale, section_n))
    }

    fixum doc_mod.Node heading ← doc_mod.leaf("div", [doc_mod.attr("class", "side-h")], g.label)
    fixum doc_mod.Node list ← doc_mod.element("ul", [doc_mod.attr("class", "nav")], items)
    redde doc_mod.frag([heading, list])
}

# Render every sidebar group for one page.
@ publica
functio genera_nav(textus active_section, textus pagina_href, textus site_locale) → doc_mod.Node {
    fixum lista<NavGroup> groups ← nav_tree()
    varia numerus section_n ← 0
    si non pagina_in_arbore(groups, pagina_href, site_locale) {
        section_n ← numerus_sectionis(groups, active_section)
    }

    varia lista<doc_mod.Node> nodes ← vacua
    itera ex groups fixum g {
        nodes.appende(nav_group_node(g, active_section, pagina_href, site_locale, section_n))
    }
    redde doc_mod.frag(nodes)
}
