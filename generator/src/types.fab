# Core types for the Speculum site generator.

importa ex "./frontmatter" * ut fm
importa ex "./fence" * ut fence_mod
importa ex "./anchor" * ut anchor_mod

# A documentation page in any locale.
@ publica
genus Pagina {
    varia textus iter
    varia textus titulus
    varia textus section
    varia numerus positio
    varia textus corpus
    varia tabula<textus, textus> metadata
    varia lista<fence_mod.Fence> fences
    varia lista<anchor_mod.Heading> headings
    varia lista<textus> sources
    varia textus site_locale
    varia textus reader_locale
}

# The site manifest describes every page.
genus SiteManifest {
    varia lista<Pagina> paginae
    varia lista<textus> locales
    varia textus default_locale
    varia textus version
}

# Build a Pagina from raw Markdown source.
@ publica
functio aedifica_paginam(textus iter, textus source, textus site_locale, textus reader_locale) → Pagina {
    fixum fm.Split split ← fm.divide(source)
    fixum textus titulus ← field_vale(split.fields, "title", iter)
    fixum textus section ← field_vale(split.fields, "section", "misc")
    fixum lista<fence_mod.Fence> fences ← fence_mod.extract(split.body)
    fixum lista<anchor_mod.Heading> headings ← anchor_mod.extract(split.body)
    fixum lista<textus> sources ← field_lista(split.fields, "sources")

    redde Pagina { iter = iter, titulus = titulus, section = section, positio = 0, corpus = split.body, metadata = split.fields, fences = fences, headings = headings, sources = sources, site_locale = site_locale, reader_locale = reader_locale }
}

# Get a string value from frontmatter, with fallback.
@ publica
functio field_vale(tabula<textus, textus> fields, textus key, textus fallback) → textus {
    si fields.habet(key) {
        redde fields[key] ↦ textus
    }
    redde fallback
}

# Get a lista from a frontmatter array string.
functio field_lista(tabula<textus, textus> fields, textus key) → lista<textus> {
    fac {
        fixum textus raw ← fields[key] ↦ textus
        redde [raw]
    }
    cape err {
        redde vacua
    }
}
