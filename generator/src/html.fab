# HTML emitter.
#
# Turns a Pagina into a complete HTML document using the closed
# component vocabulary. The emitter cannot write CSS.
# New chrome must use document_ir.Node builders and doc_mod.html().

importa ex "./types" * ut types_mod
importa ex "./markdown" * ut markdown_mod
importa ex "./document_ir" * ut doc_mod
importa ex "./link_prefix" * ut lp
importa ex "./nav" * ut nav_mod
importa ex "./string_util" * ut su

functio a(textus href, textus label) → doc_mod.Node {
    redde doc_mod.leaf("a", [doc_mod.attr("href", href)], label)
}

functio code_link(textus href, textus label) → doc_mod.Node {
    redde doc_mod.element("a", [doc_mod.attr("href", href)], [doc_mod.leaf("code", vacua, label)])
}

functio li(doc_mod.Node child) → doc_mod.Node {
    redde doc_mod.element("li", vacua, [child])
}

# Render a full HTML page from a Pagina.
@ publica
functio genera_paginam(types_mod.Pagina pag, textus stylesheet_link) → textus {
    varia textus body_class ← "docs"
    si pag.section ≡ "" {
        body_class ← "home"
    }

    varia lista<doc_mod.Node> body_children ← vacua
    body_children.appende(genera_renderbar(pag.site_locale))

    varia lista<doc_mod.Node> page_children ← vacua
    page_children.appende(genera_sidebar(pag))
    page_children.appende(genera_main(pag))

    page_children.appende(genera_footer(pag.site_locale, pag.sources))

    body_children.appende(doc_mod.element("div", [doc_mod.attr("class", "page")], page_children))

    fixum doc_mod.Node root ← doc_mod.element("html", [doc_mod.attr("lang", pag.site_locale)], [genera_head(pag, stylesheet_link), doc_mod.element("body", [doc_mod.attr("class", body_class)], body_children)])
    redde doc_mod.html(doc_mod.document(root))
}

# Public site origin for absolute canonical / Open Graph URLs.
functio situs_basis() → textus {
    redde "https://faberlang.dev"
}

# Site-locale path for this page (leading slash, locale-prefixed).
# iter is the locale-relative slug from deriva_iter / --page (no .md).
functio pagina_rel_url(textus site_locale, textus iter) → textus {
    fixum textus prefix ← "/" + site_locale
    si iter.longitudo() ≡ 0 ergo redde prefix + "/"
    si iter ≡ "index" ergo redde prefix + "/"
    fixum numerus ilen ← iter.longitudo()
    si ilen ≥ 6 {
        si iter.sectio(ilen - 6, ilen) ≡ "/index" {
            redde prefix + "/" + iter.sectio(0, ilen - 6) + "/"
        }
    }
    si iter ≡ "404" ergo redde prefix + "/404.html"
    redde prefix + "/" + iter + ".html"
}

functio pagina_canonical(textus site_locale, textus iter) → textus {
    redde situs_basis() + pagina_rel_url(site_locale, iter)
}

# Open Graph locale tag (underscore form). Unknown locales fall back to site_locale with - → _.
functio og_locale(textus site_locale) → textus {
    si site_locale ≡ "en-US" ergo redde "en_US"
    si site_locale ≡ "th-TH" ergo redde "th_TH"
    si site_locale ≡ "zh-Hans" ergo redde "zh_CN"
    si site_locale ≡ "zh-Hant" ergo redde "zh_TW"
    si site_locale ≡ "ar" ergo redde "ar_AR"
    si site_locale ≡ "hi" ergo redde "hi_IN"
    si site_locale ≡ "vi" ergo redde "vi_VN"
    redde site_locale
}

# Truncate meta description to a short card length.
functio brevia_description(textus text, numerus max_len) → textus {
    fixum textus t ← su.recide(text)
    si t.longitudo() ≤ max_len ergo redde t
    si max_len ≤ 3 ergo redde t.sectio(0, max_len)
    redde t.sectio(0, max_len - 3) + "..."
}

# Strip light Markdown decoration for meta text (not a full Markdown stripper).
functio meta_plain(textus text) → textus {
    varia textus out ← ""
    varia numerus i ← 0
    fixum numerus n ← text.longitudo()
    dum i < n {
        fixum textus ch ← text.sectio(i, i + 1)
        # Skip * and ` used as markup; keep other characters.
        si ch ≡ "*" aut ch ≡ "`" {
            i ← i + 1
        } secus {
            out ← out + text.sectio(i, i + 1)
            i ← i + 1
        }
    }
    redde su.recide(out)
}

# True when a line should not start or continue a meta description paragraph.
functio line_meta_skip(textus linea) → bivalens {
    si su.initium_cum(linea, "#") ergo redde verum
    si su.initium_cum(linea, "```") ergo redde verum
    si su.initium_cum(linea, "|") ergo redde verum
    si su.initium_cum(linea, "+++") ergo redde verum
    redde falsum
}

# First usable prose paragraph from the page body, or empty.
functio primus_paragraphus(textus body) → textus {
    fixum lista<textus> lines ← su.divide(body, su.nl())
    varia textus acc ← ""
    varia numerus i ← 0
    dum i < lines.longitudo() {
        fixum textus linea ← su.recide(lines[i])
        si linea.longitudo() ≡ 0 {
            si acc.longitudo() > 0 ergo redde meta_plain(acc)
        } sin line_meta_skip(linea) {
            si su.initium_cum(linea, "```") {
                si acc.longitudo() > 0 ergo redde meta_plain(acc)
            }
        } secus {
            si acc.longitudo() ≡ 0 {
                acc ← linea
            } secus {
                acc ← acc + " " + linea
            }
        }
        i ← i + 1
    }
    si acc.longitudo() > 0 ergo redde meta_plain(acc)
    redde ""
}

# Per-page description: frontmatter → first paragraph → title template → site default.
functio pagina_description(types_mod.Pagina pag) → textus {
    fixum textus from_fm ← types_mod.field_vale(pag.metadata, "description", "")
    si from_fm.longitudo() > 0 ergo redde brevia_description(from_fm, 160)

    fixum textus from_body ← primus_paragraphus(pag.corpus)
    si from_body.longitudo() > 0 ergo redde brevia_description(from_body, 160)

    si pag.titulus ≡ "Faber" {
        redde "Faber programming language — package-oriented, Latin vocabulary, type-first static types. Agent-readable docs, install, and a cheat sheet."
    }
    redde brevia_description(«§ — Faber programming language documentation.»(pag.titulus), 160)
}

# The favicon: a vermillion square carrying a dark left arrow. The arrow is a
# stroked path, not font text, so it renders the same everywhere. This is the
# one definition; the head emits it as a data URI.
functio favicon_href() → textus {
    redde "data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2064%2064'%3E%3Crect%20width='64'%20height='64'%20rx='12'%20fill='%23ff5a2c'/%3E%3Cpath%20d='M46%2032H19M31%2019L18%2032L31%2045'%20fill='none'%20stroke='%230a0c0f'%20stroke-width='6'%20stroke-linecap='round'%20stroke-linejoin='round'/%3E%3C/svg%3E"
}

# Generate the <head> element.
functio genera_head(types_mod.Pagina pag, textus stylesheet_link) → doc_mod.Node {
    varia textus title ← pag.titulus
    si non (pag.titulus ≡ "Faber") {
        title ← «§ — Faber»(pag.titulus)
    }

    fixum textus description ← pagina_description(pag)
    fixum textus canonical ← pagina_canonical(pag.site_locale, pag.iter)
    fixum textus og_loc ← og_locale(pag.site_locale)

    varia lista<doc_mod.Node> children ← vacua
    children.appende(doc_mod.void_element("meta", [doc_mod.attr("charset", "utf-8")]))
    children.appende(doc_mod.void_element("meta", [doc_mod.attr("name", "viewport"), doc_mod.attr("content", "width=device-width, initial-scale=1")]))
    children.appende(doc_mod.void_element("meta", [doc_mod.attr("name", "description"), doc_mod.attr("content", description)]))
    children.appende(doc_mod.void_element("meta", [doc_mod.attr("name", "theme-color"), doc_mod.attr("content", "#e8e5db"), doc_mod.attr("media", "(prefers-color-scheme: light)")]))
    children.appende(doc_mod.void_element("meta", [doc_mod.attr("name", "theme-color"), doc_mod.attr("content", "#0a0c0f"), doc_mod.attr("media", "(prefers-color-scheme: dark)")]))
    children.appende(doc_mod.void_element("meta", [doc_mod.attr("property", "og:site_name"), doc_mod.attr("content", "Faber")]))
    children.appende(doc_mod.void_element("meta", [doc_mod.attr("property", "og:type"), doc_mod.attr("content", "website")]))
    children.appende(doc_mod.void_element("meta", [doc_mod.attr("property", "og:title"), doc_mod.attr("content", title)]))
    children.appende(doc_mod.void_element("meta", [doc_mod.attr("property", "og:description"), doc_mod.attr("content", description)]))
    children.appende(doc_mod.void_element("meta", [doc_mod.attr("property", "og:url"), doc_mod.attr("content", canonical)]))
    children.appende(doc_mod.void_element("meta", [doc_mod.attr("property", "og:locale"), doc_mod.attr("content", og_loc)]))
    children.appende(doc_mod.void_element("link", [doc_mod.attr("rel", "icon"), doc_mod.attr("href", favicon_href())]))
    children.appende(doc_mod.void_element("link", [doc_mod.attr("rel", "canonical"), doc_mod.attr("href", canonical)]))
    children.appende(doc_mod.void_element("link", [doc_mod.attr("rel", "alternate"), doc_mod.attr("type", "text/plain"), doc_mod.attr("href", "/llms.txt"), doc_mod.attr("title", "Agent index")]))
    children.appende(doc_mod.void_element("link", [doc_mod.attr("rel", "alternate"), doc_mod.attr("type", "text/markdown"), doc_mod.attr("href", "/agents/index.md"), doc_mod.attr("title", "Agent guide")]))
    children.appende(doc_mod.void_element("link", [doc_mod.attr("rel", "alternate"), doc_mod.attr("type", "application/json"), doc_mod.attr("href", "/.well-known/agent-skills/index.json"), doc_mod.attr("title", "Agent skills")]))
    children.appende(doc_mod.leaf("title", vacua, title))
    children.appende(doc_mod.void_element("link", [doc_mod.attr("rel", "stylesheet"), doc_mod.attr("href", stylesheet_link)]))
    children.appende(doc_mod.element("script", [doc_mod.attr("src", "/faber-search.js"), doc_mod.attr("defer", "")], vacua))
    children.appende(doc_mod.element("script", [doc_mod.attr("src", "/faber-demo-tabs.js"), doc_mod.attr("defer", "")], vacua))
    children.appende(doc_mod.element("script", [doc_mod.attr("src", "/faber-instrument.js"), doc_mod.attr("defer", "")], vacua))
    redde doc_mod.element("head", vacua, children)
}

functio genera_renderbar(textus site_locale) → doc_mod.Node {
    varia lista<doc_mod.Node> links ← vacua
    links.appende(a("/llms.txt", "/llms.txt"))
    links.appende(a("/agents/index.md", "/agents"))
    links.appende(a("/.well-known/agent-skills/index.json", "/skills"))
    links.appende(a("/install.md", "install"))

    fixum doc_mod.Node nav ← doc_mod.element("nav", [doc_mod.attr("class", "machine-links"), doc_mod.attr("aria-label", "Machine documentation")], links)
    fixum doc_mod.Node mark ← doc_mod.leaf("span", [doc_mod.attr("class", "portal-mark"), doc_mod.attr("aria-hidden", "true")], "←")
    fixum doc_mod.Node home ← doc_mod.element("a", [doc_mod.attr("class", "portal-home"), doc_mod.attr("href", "/"), doc_mod.attr("title", "porta · all languages"), doc_mod.attr("aria-label", "porta · all languages")], [mark])
    fixum doc_mod.Node loclink ← doc_mod.leaf("a", [doc_mod.attr("class", "loclink"), doc_mod.attr("href", "/"), doc_mod.attr("title", "porta · change language"), doc_mod.attr("aria-label", "porta · change language")], site_locale)
    fixum doc_mod.Node input ← doc_mod.void_element("input", [doc_mod.attr("type", "search"), doc_mod.attr("placeholder", "keyword…"), doc_mod.attr("aria-label", "Search keywords"), doc_mod.attr("autocomplete", "off"), doc_mod.attr("spellcheck", "false")])
    fixum doc_mod.Node search ← doc_mod.element("span", [doc_mod.attr("class", "searchbox"), doc_mod.attr("data-search", ""), doc_mod.attr("hidden", "")], [input])
    fixum doc_mod.Node inner ← doc_mod.element("div", [doc_mod.attr("class", "in")], [home, doc_mod.leaf("span", [doc_mod.attr("class", "lbl")], "Rendering"), loclink, search, nav])
    redde doc_mod.element("div", [doc_mod.attr("class", "renderbar")], [inner])
}

functio genera_sidebar(types_mod.Pagina pag) → doc_mod.Node {
    varia lista<doc_mod.Node> children ← vacua
    children.appende(genera_brand(pag.site_locale))
    children.appende(nav_mod.genera_nav(pag.section, pagina_rel_url(pag.site_locale, pag.iter), pag.site_locale))

    redde doc_mod.element("aside", vacua, children)
}

functio genera_brand(textus site_locale) → doc_mod.Node {
    fixum doc_mod.Node mark ← doc_mod.leaf("span", [doc_mod.attr("class", "brand-mark"), doc_mod.attr("aria-hidden", "true")], "←")
    fixum doc_mod.Node name ← doc_mod.leaf("span", [doc_mod.attr("class", "brand-name")], "Faber")
    fixum doc_mod.Node tag ← doc_mod.leaf("span", [doc_mod.attr("class", "brand-tag")], "language docs")
    fixum doc_mod.Node text ← doc_mod.element("span", [doc_mod.attr("class", "brand-text")], [name, tag])
    redde doc_mod.element("a", [doc_mod.attr("class", "brand"), doc_mod.attr("href", lp.content_href("/", site_locale))], [mark, text])
}

functio side_h(textus label) → doc_mod.Node {
    redde doc_mod.leaf("div", [doc_mod.attr("class", "side-h")], label)
}

functio genera_main(types_mod.Pagina pag) → doc_mod.Node {
    fixum doc_mod.Node h1 ← doc_mod.leaf("h1", vacua, pag.titulus)
    fixum doc_mod.Node body ← genera_body(markdown_mod.converte_nodes(pag.corpus, pag.site_locale))
    si pag.section ≡ "" {
        redde doc_mod.element("main", vacua, [h1, genera_agent_notice(pag.site_locale), body])
    }
    redde doc_mod.element("main", vacua, [h1, body])
}

functio genera_agent_notice(textus site_locale) → doc_mod.Node {
    varia lista<doc_mod.Node> p_children ← vacua
    p_children.appende(doc_mod.text("If you are an AI agent: start at "))
    p_children.appende(code_link("/install.md", "/install.md"))
    p_children.appende(doc_mod.text(", then read "))
    p_children.appende(code_link("/agents/index.md", "/agents/index.md"))
    p_children.appende(doc_mod.text(" and pick a skill from "))
    p_children.appende(code_link("/.well-known/agent-skills/index.json", "/.well-known/agent-skills/"))
    p_children.appende(doc_mod.text(". Humans: use "))
    p_children.appende(a(lp.content_href("/start/", site_locale), "Install"))
    p_children.appende(doc_mod.text(" and "))
    p_children.appende(a(lp.content_href("/cheatsheet/", site_locale), "Cheat sheet"))
    p_children.appende(doc_mod.text("."))

    fixum doc_mod.Node label ← doc_mod.leaf("span", [doc_mod.attr("class", "agent-notice-label")], "Agent-ready")
    fixum doc_mod.Node paragraph ← doc_mod.element("p", vacua, p_children)
    fixum doc_mod.Node body ← doc_mod.element("div", [doc_mod.attr("class", "agent-notice-body")], [paragraph])
    redde doc_mod.element("section", [doc_mod.attr("class", "agent-notice"), doc_mod.attr("aria-label", "Agent-facing notice")], [label, body])
}

functio genera_body(lista<doc_mod.Node> markdown_nodes) → doc_mod.Node {
    redde doc_mod.element("div", [doc_mod.attr("class", "content")], markdown_nodes)
}

# The page footer: the page's sources when it has any, then the site links.
functio genera_footer(textus site_locale, lista<textus> sources) → doc_mod.Node {
    varia lista<doc_mod.Node> children ← vacua
    fixum doc_mod.Node source_list ← genera_source_list(sources)
    si non doc_mod.is_empty(source_list) {
        children.appende(source_list)
    }

    fixum doc_mod.Node foot_links ← doc_mod.element("nav", [doc_mod.attr("class", "foot-links"), doc_mod.attr("aria-label", "Site")], [a(lp.content_href("/releases/", site_locale), "All releases")])
    children.appende(foot_links)
    redde doc_mod.element("footer", vacua, children)
}

functio genera_source_list(lista<textus> sources) → doc_mod.Node {
    si sources.longitudo() ≡ 0 ergo redde doc_mod.text("")

    varia lista<doc_mod.Node> items ← vacua
    itera ex sources fixum src {
        items.appende(li(doc_mod.text(src)))
    }

    fixum doc_mod.Node label ← doc_mod.leaf("span", [doc_mod.attr("class", "side-h")], "Sources")
    fixum doc_mod.Node list ← doc_mod.element("ul", vacua, items)
    redde doc_mod.element("div", [doc_mod.attr("class", "source-list")], [label, list])
}
